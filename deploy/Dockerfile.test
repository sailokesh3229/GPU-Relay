# Test image: runs the suite on Linux (CI-style; torch/TF tests skip without those extras).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /src
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install -e ".[dev,dashboard]" numpy "hypothesis>=6.100"
COPY tests ./tests
CMD ["python", "-m", "pytest", "-q", "tests/unit"]
